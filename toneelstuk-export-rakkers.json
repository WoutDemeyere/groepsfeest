  "lines": [
    {
      "id": "scene-1",
      "characterId": "",
      "text": "Scene 1",
      "type": "sectie"
    },
    {
      "id": "line-1-1",
      "characterId": "char-maanu",
      "text": "wat valt er te beleven op mars?",
      "type": "tekst"
    },
    {
      "id": "line-1-2",
      "characterId": "char-emmanuella",
      "text": "blijkbaar is er oorlog. Ik stel voor dat we opsplitsen en kijken of we iemand vinden.",
      "type": "tekst"
    },
    {
      "id": "line-1-3",
      "characterId": "char-verteller",
      "text": "Ze wandelen elk een kant uit.",
      "type": "actie"
    },
    {
      "id": "scene-2",
      "characterId": "",
      "text": "Scene 2",
      "type": "sectie"
    },
    {
      "id": "line-2-1",
      "characterId": "char-verteller",
      "text": "Maanu/man schuilt achter rots.",
      "type": "actie"
    },
    {
      "id": "line-2-2",
      "characterId": "char-snickerkoning",
      "text": "al jarenlang leven we in de schaduw van de marzen. Het is niet omdat we noten hebben dat we slechter zijn",
      "type": "tekst"
    },
    {
      "id": "line-2-3",
      "characterId": "char-verteller",
      "text": "De snickers juigen.",
      "type": "actie"
    },
    {
      "id": "line-2-4",
      "characterId": "char-snickerkoning",
      "text": "ons tijd is gekomen. We nemen de planeet over!",
      "type": "tekst"
    },
    {
      "id": "line-2-5",
      "characterId": "char-snicker",
      "text": "op naar de wapenkamer",
      "type": "tekst"
    },
    {
      "id": "line-2-6",
      "characterId": "char-verteller",
      "text": "Alle snickers gaan weg behalve snickerromeo blijft.",
      "type": "actie"
    },
    {
      "id": "line-2-7",
      "characterId": "char-snickerromeo",
      "text": "Oh mars-julia, ons liefde is gedoemd. Oorlog is het laatste wat we nodig hebben. Ik heb noten, jij niet. Zijn we daarom zo anders?",
      "type": "tekst"
    },
    {
      "id": "line-2-8",
      "characterId": "char-verteller",
      "text": "Triestig gaat hij af.",
      "type": "actie"
    },
    {
      "id": "line-2-9",
      "characterId": "char-maanu",
      "text": "oeii, de oorlog gaat starten, ik moet emmanuella gaan verwittigen",
      "type": "tekst"
    },
    {
      "id": "line-2-10",
      "characterId": "char-verteller",
      "text": "Maanu/man gaat weg.",
      "type": "actie"
    },
    {
      "id": "scene-3",
      "characterId": "",
      "text": "Scene 3",
      "type": "sectie"
    },
    {
      "id": "line-3-1",
      "characterId": "char-verteller",
      "text": "De marzen komen op aan de rechter kant en marsjulia zit in haar toren, emmanuella luistert wat mee.",
      "type": "actie"
    },
    {
      "id": "line-3-2",
      "characterId": "char-marskoning",
      "text": "wij waren hier eerst. De planeet is van ons! We willen in vrede leven, maar ze geven ons geen keus!",
      "type": "tekst"
    },
    {
      "id": "line-3-3",
      "characterId": "char-marskoning",
      "text": "marsjulia, blijf in je toren zo kan jou niets overkomen, de rest van ons gaan ons klaarmaken voor de strijd",
      "type": "tekst"
    },
    {
      "id": "line-3-4",
      "characterId": "char-maanu",
      "text": "mars: die snickers hebben teveel noten op hun zang!",
      "type": "tekst"
    },
    {
      "id": "line-3-5",
      "characterId": "char-verteller",
      "text": "Alle marzen gaan weg, marsjulia blijft in haar toren.",
      "type": "actie"
    },
    {
      "id": "line-3-6",
      "characterId": "char-marsjulia",
      "text": "ooh snickerromeo, ik wil geen oorlog. Ik wil in vrede bij jou zijn.",
      "type": "tekst"
    },
    {
      "id": "scene-4",
      "characterId": "",
      "text": "Scene 4",
      "type": "sectie"
    },
    {
      "id": "line-4-1",
      "characterId": "char-verteller",
      "text": "Snickerromeo komt stilletjes op en gaat naar marsjulia.",
      "type": "actie"
    },
    {
      "id": "line-4-2",
      "characterId": "char-marsjulia",
      "text": "snickerromeo? Wat da jij hier? Als mijn vader jou vindt, vermoordt hij jou!",
      "type": "tekst"
    },
    {
      "id": "line-4-3",
      "characterId": "char-snickerromeo",
      "text": "marsjulia, er komt oorlog, maar eerst wil je jou iets vragen",
      "type": "tekst"
    },
    {
      "id": "line-4-4",
      "characterId": "char-verteller",
      "text": "Hij gooit zijn bloemen naar marsjulia.",
      "type": "actie"
    },
    {
      "id": "line-4-5",
      "characterId": "char-snickerromeo",
      "text": "wil je met mij trouwen",
      "type": "tekst"
    },
    {
      "id": "line-4-6",
      "characterId": "char-verteller",
      "text": "Marsjulia houdt de handen voor het gezicht van verbasing, maar voor ze kan antwoorden breekt de oorlog uit.",
      "type": "actie"
    },
    {
      "id": "scene-5",
      "characterId": "",
      "text": "Scene 5",
      "type": "sectie"
    },
    {
      "id": "line-5-1",
      "characterId": "char-verteller",
      "text": "Van links komen de snickers en van rechts de marzen.",
      "type": "actie"
    },
    {
      "id": "line-5-2",
      "characterId": "char-verteller",
      "text": "Ze schieten op elkaar, wanneer de muziek stopt valt snickerromeo traag op de grond met zijn handen op zijn schotwonde.",
      "type": "actie"
    },
    {
      "id": "line-5-3",
      "characterId": "char-otis",
      "text": "Otis doet een toertje en schiet snickerromeo dood",
      "type": "tekst"
    },
    {
      "id": "line-5-4",
      "characterId": "char-marsjulia",
      "text": "NEEEE snickerromeo",
      "type": "tekst"
    },
    {
      "id": "line-5-5",
      "characterId": "char-verteller",
      "text": "Marsjulia stormt naar beneden.",
      "type": "actie"
    },
    {
      "id": "line-5-6",
      "characterId": "char-verteller",
      "text": "De marzen en snickers gaan wat naar achter, de koningen blijven in het midden.",
      "type": "actie"
    },
    {
      "id": "line-5-7",
      "characterId": "char-verteller",
      "text": "De koningen hun mond vallen open van verbazing.",
      "type": "actie"
    },
    {
      "id": "line-5-8",
      "characterId": "char-marskoning",
      "text": "een snicker?",
      "type": "tekst"
    },
    {
      "id": "line-5-9",
      "characterId": "char-snickerkoning",
      "text": "en een mars? Da mag helemaal niet",
      "type": "tekst"
    },
    {
      "id": "line-5-10",
      "characterId": "char-marsjulia",
      "text": "is er een dokter in de zaal?",
      "type": "tekst"
    },
    {
      "id": "line-5-11",
      "characterId": "char-verteller",
      "text": "De dokter komt op.",
      "type": "actie"
    },
    {
      "id": "line-5-12",
      "characterId": "char-dokteroj",
      "text": "Ja, ik ben dokter Oj, laat mij eens luisteren",
      "type": "tekst"
    },
    {
      "id": "line-5-13",
      "characterId": "char-verteller",
      "text": "Dokter Oj doet koptelefoon aan.",
      "type": "actie"
    },
    {
      "id": "line-5-14",
      "characterId": "char-verteller",
      "text": "Hij luistert met zijn stethoscoop en doet een teken dat snickerromeo dood is.",
      "type": "actie"
    },
    {
      "id": "line-5-15",
      "characterId": "char-verteller",
      "text": "Wanneer marsjulia een wit doek over snickerromeo legt schiet hij toch wakker",
      "type": "actie"
    },
    {
      "id": "line-5-16",
      "characterId": "char-marsjulia",
      "text": "Snickerromeo! Je leeft!",
      "type": "tekst"
    },
    {
      "id": "line-5-17",
      "characterId": "char-snickerromeo",
      "text": "ja tuurlijk, dokter Oj is helemaal geen dokter, das nen DJ",
      "type": "tekst"
    },
    {
      "id": "line-5-18",
      "characterId": "char-marsjulia",
      "text": "snickerromeo, je vroeg of ik wou trouwen. Dat wil ik zeker!",
      "type": "tekst"
    },
    {
      "id": "line-5-19",
      "characterId": "char-verteller",
      "text": "Iedereen juigt.",
      "type": "actie"
    },
    {
      "id": "line-5-20",
      "characterId": "char-verteller",
      "text": "Discobol komt op.",
      "type": "actie"
    },
    {
      "id": "line-5-21",
      "characterId": "char-verteller",
      "text": "Ze dansen en gaan allemaal weg.",
      "type": "actie"
    },
    {
      "id": "scene-6",
      "characterId": "",
      "text": "Scene 6",
      "type": "sectie"
    },
    {
      "id": "line-6-1",
      "characterId": "char-bounty",
      "text": "Bounty komt alleen op.",
      "type": "actie"
    },
    {
      "id": "line-6-2",
      "characterId": "char-verteller",
      "text": "Maanu en emmanuella volgen.",
      "type": "actie"
    },
    {
      "id": "line-6-3",
      "characterId": "char-emmanuella",
      "text": "waarom zit je hier zo alleen?",
      "type": "tekst"
    },
    {
      "id": "line-6-4",
      "characterId": "char-bounty",
      "text": "ik ben geen echte noot",
      "type": "tekst"
    },
    {
      "id": "line-6-5",
      "characterId": "char-maanu",
      "text": "op planeet aarde hebben kokosnoten",
      "type": "tekst"
    },
    {
      "id": "line-6-6",
      "characterId": "char-emmanuella",
      "text": "jup en wij zijn op weg naar daar, wil je mee?",
      "type": "tekst"
    },
    {
      "id": "line-6-7",
      "characterId": "char-bounty",
      "text": "ja heel graag!",
      "type": "tekst"
    },
    {
      "id": "line-6-8",
      "characterId": "char-verteller",
      "text": "Ze gaan samen naar het ruimteschip.",
      "type": "actie"
    }
  ],
