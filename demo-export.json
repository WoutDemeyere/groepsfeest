    { "id": "line-1", "characterId": "", "text": "Scène 1 — De bakkerij", "type": "sectie" },
    { "id": "line-2", "characterId": "char-1", "text": "De deurbel rinkelt precies op tijd.", "type": "tekst" },
    { "id": "line-3", "characterId": "char-2", "text": "Ik hoorde het al in de gang, dit wordt geen stille avond.", "type": "tekst" },
    { "id": "line-4", "characterId": "", "text": "Het licht dimt, alleen de toonbank blijft warm belicht.", "type": "actie" },
    { "id": "line-5", "characterId": "char-3", "text": "Als we dit samen doen, voelt de zaal minder leeg.", "type": "tekst" },
    { "id": "line-6", "characterId": "char-4", "text": "De oven zoemt alsof hij mee ademt.", "type": "tekst" },
    { "id": "line-7", "characterId": "", "text": "Scène 2 — Aan de vitrine", "type": "sectie" },
    { "id": "line-8", "characterId": "char-1", "text": "We hebben nog tien minuten. Wat is de eerste cue?", "type": "tekst" },
    { "id": "line-9", "characterId": "char-2", "text": "Een zachte bas en dan een helder licht op de deur.", "type": "tekst" },
    { "id": "line-10", "characterId": "", "text": "De dansers komen op en vormen een halve cirkel.", "type": "actie" }
