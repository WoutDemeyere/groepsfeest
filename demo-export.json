      "text": "Scène 1 – Toekomst op Pluto",
      "type": "sectie"
    },
    {
      "id": "line-1-1",
      "characterId": "char-maanu",
      "text": "Huh Pluto? Is mijn gps nu weer kapot? Ik wou naar Chiro Avelgem op de aarde.",
      "type": "tekst"
    },
    {
      "id": "line-1-2",
      "characterId": "char-groep",
      "text": "Kom dat zien! Kom dat zien! Ons groot duivelsfeest!",
      "type": "tekst"
    },
    {
      "id": "line-1-3",
      "characterId": "char-groep",
      "text": "Een groep komt op het podium en loopt af.",
      "type": "actie"
    },

    {
      "id": "scene-2",
      "characterId": "",
      "text": "Scène 2 – Het Duivelsfeest",
      "type": "sectie"
    },
    {
      "id": "line-2-1",
      "characterId": "char-maanu",
      "text": "Ik ga eens gaan kijken in de discotheek om daar vriendjes te vinden.",
      "type": "tekst"
    },
    {
      "id": "line-2-2",
      "characterId": "char-groep",
      "text": "DJ achter een tafel – iedereen danst.",
      "type": "actie"
    },

    {
      "id": "scene-3",
      "characterId": "",
      "text": "Scène 3 – Dichte groep tijdens de dans",
      "type": "sectie"
    },
    {
      "id": "line-3-1",
      "characterId": "char-groep",
      "text": "Begin dans – groep danst dicht bij elkaar.",
      "type": "actie"
    },
    {
      "id": "line-3-2",
      "characterId": "char-groep",
      "text": "Einde dans.",
      "type": "actie"
    },

    {
      "id": "scene-4",
      "characterId": "",
      "text": "Scène 4 – Verdrietig meisje",
      "type": "sectie"
    },
    {
      "id": "line-4-1",
      "characterId": "char-meisje",
      "text": "Je hoort hier niet! Je bent anders dan de rest!",
      "type": "tekst"
    },
    {
      "id": "line-4-2",
      "characterId": "char-meisje",
      "text": "Ik voel me zo verdomd alleen!",
      "type": "tekst"
    },
    {
      "id": "line-4-3",
      "characterId": "char-groep",
      "text": "2 kapoentjes lopen van het podium.",
      "type": "actie"
    }
