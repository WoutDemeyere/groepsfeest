  "lines": [
    {
      "id": "scene-1",
      "characterId": "",
      "text": "Scène 1 – De Omslag",
      "type": "sectie"
    },
    {
      "id": "line-1-1",
      "characterId": "char-1",
      "text": "Dit is een extreem lange repliek die expres te veel woorden bevat, zodat de layout moet breken en opnieuw moet vloeien zonder dat er iets overlap of wegvalt in de export.",
      "type": "tekst"
    },
    {
      "id": "line-1-2",
      "characterId": "char-2",
      "text": "Ik zeg: start, start, start — en toch begint er niets, alsof het podium weigert mee te werken met mijn stem.",
      "type": "tekst"
    },
    {
      "id": "line-1-3",
      "characterId": "char-4",
      "text": "Licht gaat aan, rookmachine sputtert, en iemand struikelt over een kabel.",
      "type": "actie"
    },
    {
      "id": "line-1-4",
      "characterId": "char-3",
      "text": "Onderbreking: een zachte fluistering met extra, extra, extra veel herhaling voor testing.",
      "type": "tekst"
    },
    {
      "id": "line-1-5",
      "characterId": "char-5",
      "text": "Wij zijn het koor, wij vullen de ruimte met klankklankklank en woorden die geen einde kennen.",
      "type": "tekst"
    },
    {
      "id": "line-1-6",
      "characterId": "char-1",
      "text": "Een tweede lange zin met vreemde_spaties_en_onderstreping die moeilijk breekt en extra lang doorloopt.",
      "type": "tekst"
    },
    {
      "id": "line-1-7",
      "characterId": "char-4",
      "text": "Decor schuift traag, een stoel valt, iemand markeert een plek met tape.",
      "type": "actie"
    },
    {
      "id": "line-1-8",
      "characterId": "char-2",
      "text": "Herhaling herhaling herhaling herhaling herhaling om overlap te testen.",
      "type": "tekst"
    },
    {
      "id": "scene-2",
      "characterId": "",
      "text": "Scène 2 – De Overload",
      "type": "sectie"
    },
    {
      "id": "line-2-1",
      "characterId": "char-2",
      "text": "Dit is de overload: 1234567890, symbolen !?@# en woorden-met-streepjes die lang zijn en hard moeten wrappen.",
      "type": "tekst"
    },
    {
      "id": "line-2-2",
      "characterId": "char-1",
      "text": "Ik loop, ik loop, ik loop, ik loop, ik loop, ik loop — totdat ik geen adem meer heb en toch blijf praten.",
      "type": "tekst"
    },
    {
      "id": "line-2-3",
      "characterId": "char-4",
      "text": "Projectie start, video knippert, audio valt stil, dan plots heel luid.",
      "type": "actie"
    },
    {
      "id": "line-2-4",
      "characterId": "char-6",
      "text": "Publiek reageert: ooooh, aaah, fluit, klap, en een verdwaalde lach op het verkeerde moment.",
      "type": "tekst"
    },
    {
      "id": "line-2-5",
      "characterId": "char-3",
      "text": "Onder water klinkt alles traag; woorden rekken uit, consonanten blijven hangen.",
      "type": "tekst"
    },
    {
      "id": "line-2-6",
      "characterId": "char-4",
      "text": "Laser beweegt te snel, operator corrigeert handmatig.",
      "type": "actie"
    },
    {
      "id": "line-2-7",
      "characterId": "char-5",
      "text": "KOOR KOOR KOOR KOOR KOOR — ritme knettert, timing schuift.",
      "type": "tekst"
    },
    {
      "id": "line-2-8",
      "characterId": "char-1",
      "text": "Een superlangezinzonderenigeonderbrekingdiehetwrappenmoetforcerenookalishijonnatuurlijk.",
      "type": "tekst"
    },
    {
      "id": "scene-3",
      "characterId": "",
      "text": "Scène 3 – De Stilte",
      "type": "sectie"
    },
    {
      "id": "line-3-1",
      "characterId": "char-4",
      "text": "Alle lichten uit. Iedereen bevriest. Stilte.",
      "type": "actie"
    },
    {
      "id": "line-3-2",
      "characterId": "char-3",
      "text": "In de stilte hoor je elke voetstap. Elke ademhaling. Elke trilling.",
      "type": "tekst"
    },
    {
      "id": "line-3-3",
      "characterId": "char-1",
      "text": "Ik fluister woorden die bijna verdwijnen, maar toch te lang zijn om op één regel te blijven.",
      "type": "tekst"
    },
    {
      "id": "line-3-4",
      "characterId": "char-2",
      "text": "Kijk naar mij, kijk naar mij, kijk naar mij, zei hij terwijl niemand keek.",
      "type": "tekst"
    },
    {
      "id": "line-3-5",
      "characterId": "char-4",
      "text": "Projector gaat uit, noodlicht springt aan.",
      "type": "actie"
    },
    {
      "id": "line-3-6",
      "characterId": "char-5",
      "text": "Koor zingt heel zacht, bijna onhoorbaar, tot het ineens omslaat.",
      "type": "tekst"
    },
    {
      "id": "line-3-7",
      "characterId": "char-6",
      "text": "Publiek wordt onrustig, iemand hoest, een ander fluistert te luid.",
      "type": "tekst"
    },
    {
      "id": "line-3-8",
      "characterId": "char-1",
      "text": "Ik herhaal een woord: stilte, stilte, stilte, totdat het een echo wordt.",
      "type": "tekst"
    },
    {
      "id": "scene-4",
      "characterId": "",
      "text": "Scène 4 – De Storm",
      "type": "sectie"
    },
    {
      "id": "line-4-1",
      "characterId": "char-5",
      "text": "Het koor explodeert met volume, ritme, adem, en chaos die zich opstapelt tot een muur van geluid.",
      "type": "tekst"
    },
    {
      "id": "line-4-2",
      "characterId": "char-4",
      "text": "Stroboscoop aan, windmachine blaast papieren over het podium.",
      "type": "actie"
    },
    {
      "id": "line-4-3",
      "characterId": "char-1",
      "text": "Waarom is alles nu zo fel en zo snel en zo veel tegelijk — ik verlies de controle.",
      "type": "tekst"
    },
    {
      "id": "line-4-4",
      "characterId": "char-2",
      "text": "Ik herhaal herhaal herhaal herhaal herhaal om de cues te testen.",
      "type": "tekst"
    },
    {
      "id": "line-4-5",
      "characterId": "char-4",
      "text": "Rookscherm op, haze blijft hangen, operator veegt lens.",
      "type": "actie"
    },
    {
      "id": "line-4-6",
      "characterId": "char-3",
      "text": "De zee brult; woorden spoelen weg en komen als schuim terug.",
      "type": "tekst"
    },
    {
      "id": "line-4-7",
      "characterId": "char-6",
      "text": "Publiek klapt te vroeg, te laat, dan tegelijk, dan niet meer.",
      "type": "tekst"
    },
    {
      "id": "line-4-8",
      "characterId": "char-1",
      "text": "Ik hou het net vol, maar mijn zinnen botsen tegen de rand.",
      "type": "tekst"
    },
    {
      "id": "scene-5",
      "characterId": "",
      "text": "Scène 5 – Finale",
      "type": "sectie"
    },
    {
      "id": "line-5-1",
      "characterId": "char-4",
      "text": "Eindbeeld: iedereen naar voren, licht warm, muziek zacht.",
      "type": "actie"
    },
    {
      "id": "line-5-2",
      "characterId": "char-1",
      "text": "Dit is het einde, maar ook het begin van een nieuwe test met extreem lange zinnen die nergens anders passen.",
      "type": "tekst"
    },
    {
      "id": "line-5-3",
      "characterId": "char-2",
      "text": "FINALE: woorden botsen, cues stapelen, en de tijd wordt opgerekt.",
      "type": "tekst"
    },
    {
      "id": "line-5-4",
      "characterId": "char-3",
      "text": "Dankjewel, dankjewel, dankjewel — tot de volgende keer.",
      "type": "tekst"
    },
    {
      "id": "line-5-5",
      "characterId": "char-4",
      "text": "Gordijn dicht, spot uit, zaallicht aan.",
      "type": "actie"
    },
    {
      "id": "line-5-6",
      "characterId": "char-5",
      "text": "Koor houdt een lange noot aan tot hij breekt.",
      "type": "tekst"
    },
    {
      "id": "line-5-7",
      "characterId": "char-6",
      "text": "Publiek staat, zit, staat weer op, en roept iets onverstaanbaars.",
      "type": "tekst"
    },
    {
      "id": "line-5-8",
      "characterId": "char-2",
      "text": "Laatste test: herhaal herhaal herhaal voor overlappende cues.",
      "type": "tekst"
    }
  ],
